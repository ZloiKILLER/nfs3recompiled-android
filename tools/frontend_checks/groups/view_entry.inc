// A case's registers and stack for these functions, after caseEntry: statements on `entry`, by c.address.
switch (c.address)
{
case 0x464700:
case 0x4647a0:
    // The file's name and its folder: the world's strings.
    entry.eax = 0x5f3f40;
    entry.edx = 0x5f3f60;
    break;
default:
    break;
}
