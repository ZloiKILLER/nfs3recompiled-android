<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- The renderer targets GLES 3.0 (see include/lib/glcompat.h). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- resizeableActivity is the default at this target, and is said here
         because a desktop depends on it: in Samsung DeX the app is a window on
         a monitor, and a window the player can size is the point. -->
    <application android:label="${launcherAppLabel}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:resizeableActivity="true"
        android:hardwareAccelerated="true" >

        <!-- Launcher entry point: checks for imported game data and, on first
             run, walks the user through picking their NFS3 CD-data folder
             (see DataImporter.java) before handing off to LauncherActivity. -->
        <activity android:name="dev.nfs3hp.port.SplashActivity"
            android:theme="@style/LauncherTheme"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pre-game launcher and all of its settings screens. It remains in
             the app's normal task and is never opened over the single-instance
             SDL game activity. -->
        <activity android:name="dev.nfs3hp.port.LauncherActivity"
            android:theme="@style/LauncherTheme"
            android:label="@string/launcher_title"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden"
            android:exported="false" >
            <!-- Where there are windows rather than a screen, this one opens as
                 large as the display allows and is sized from there.  The
                 system keeps a freeform window inside the display, so asking
                 for more than any monitor has is asking for all of it. -->
            <layout android:defaultWidth="4096dp" android:defaultHeight="4096dp"
                android:minWidth="480dp" android:minHeight="320dp"
                android:gravity="center" />
        </activity>

        <!-- The actual game, an SDLActivity subclass.  Not a launcher target:
             LauncherActivity starts it once game data is confirmed present. -->
        <!-- The game runs in a process of its own.  SDL and the virtual machine
             under it set themselves up once per process and cannot do it twice:
             a second race started without the process ending in between died in
             SDLThread with SEGV_ACCERR a tenth of a second in, which the player
             saw as the game not opening on the first press of Play.  With its
             own process the game starts clean every time, and ending it leaves
             the launcher, which stays in the main process, where it was. -->
        <activity android:name="dev.nfs3hp.port.NFS3Activity"
            android:process=":game"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="landscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false"
            >
            <!-- As the launcher: the game's window opens filling the display
                 and the player sizes it from there.  The landscape lock above
                 is a phone's; on a desktop NFS3Activity lets it go, or the
                 system would hand the window one shape and letterbox the rest
                 of it. -->
            <layout android:defaultWidth="4096dp" android:defaultHeight="4096dp"
                android:minWidth="480dp" android:minHeight="320dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
