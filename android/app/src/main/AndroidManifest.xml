<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- The renderer targets GLES 3.0 (see include/lib/glcompat.h). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="${launcherAppLabel}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true" >

        <!-- Launcher entry point: checks for imported game data and, on first
             run, walks the user through picking their NFS3 CD-data folder
             (see DataImporter.java) before handing off to LauncherActivity. -->
        <activity android:name="dev.nfs3hp.port.SplashActivity"
            android:theme="@style/LauncherTheme"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pre-game launcher and all of its settings screens. It remains in
             the app's normal task and is never opened over the single-instance
             SDL game activity. -->
        <activity android:name="dev.nfs3hp.port.LauncherActivity"
            android:theme="@style/LauncherTheme"
            android:label="@string/launcher_title"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- The actual game, an SDLActivity subclass.  Not a launcher target:
             LauncherActivity starts it once game data is confirmed present. -->
        <activity android:name="dev.nfs3hp.port.NFS3Activity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false"
            >
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
