<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#34465B"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/ui_accent"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/ui_panel"/><corners android:radius="14dp"/><stroke android:width="2dp" android:color="@color/ui_accent"/></shape></item>
    <item><shape><solid android:color="@color/ui_panel"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/ui_border"/></shape></item>
</selector>
