<resources xmlns:tools="http://schemas.android.com/tools">
 <!-- Labels of the controls-mapping screen.  These stay English for now: the
      screen is where the player matches the port's assignments against NFS3's
      own settings, and the game itself is English.  Only these labels: the
      prose around them is translated like the rest of the launcher.  They stay
      ordinary resources, so a later locale can simply override them; the
      tools:ignore only stops lint reporting the gap as an oversight.
      Each array is index-parallel to the matching array in GamePreferences. -->

 <!-- Parallel to GamePreferences.ACTION_IDS. -->
 <string-array name="action_labels" tools:ignore="MissingTranslation">
  <item>Steer left</item>
  <item>Steer right</item>
  <item>Accelerate / menu up</item>
  <item>Brake / menu down</item>
  <item>Confirm / OK</item>
  <item>Handbrake</item>
  <item>Camera view</item>
  <item>Look behind</item>
  <item>Horn</item>
  <item>Spike strip</item>
  <item>Escape / pause</item>
  <item>Headlights</item>
  <item>Return to track</item>
  <item>Shift up</item>
  <item>Shift down</item>
 </string-array>

