<resources xmlns:tools="http://schemas.android.com/tools">
 <!-- Labels of the touch keys screen.  These stay English for now: the
      screen is where the player matches the port's assignments against NFS3's
      own settings, and the game itself is English.  Only these labels: the
      prose around them is translated like the rest of the launcher.  They stay
      ordinary resources, so a later locale can simply override them; the
      tools:ignore only stops lint reporting the gap as an oversight.
      Each array is index-parallel to the matching array in GamePreferences. -->

 <!-- Parallel to GamePreferences.ACTION_IDS. -->
 <string-array name="action_labels" tools:ignore="MissingTranslation">
  <item>Steer left</item>
  <item>Steer right</item>
  <item>Accelerate / menu up</item>
  <item>Brake / menu down</item>
  <item>Confirm / OK</item>
  <item>Handbrake</item>
  <item>Camera view</item>
  <item>Look behind</item>
  <item>Horn</item>
  <item>Spike strip</item>
  <item>Escape / pause</item>
  <item>Headlights</item>
  <item>Return to track</item>
  <item>Shift up</item>
  <item>Shift down</item>
 </string-array>

 <!-- Parallel to GamePreferences.KEY_VALUES. -->
 <string-array name="key_labels" tools:ignore="MissingTranslation">
  <item>@string/label_unassigned</item>
  <item>Up arrow</item>
  <item>Down arrow</item>
  <item>Left arrow</item>
  <item>Right arrow</item>
  <item>Return / Enter</item>
  <item>Escape</item>
  <item>Space</item>
  <item>C</item>
  <item>B</item>
  <item>H</item>
  <item>S</item>
  <item>L</item>
  <item>R</item>
  <item>A</item>
  <item>Z</item>
 </string-array>

 <string name="label_unassigned" tools:ignore="MissingTranslation">Unassigned</string>

 <!-- The gamepad buttons screen, English for the same reason: buttons carry
      their printed names, and actions carry the game's own names for them.
      Parallel to GamepadButtons.BUTTON_IDS. -->
 <string-array name="pad_button_labels" tools:ignore="MissingTranslation">
  <item>Cross / A</item>
  <item>Circle / B</item>
  <item>Square / X</item>
  <item>Triangle / Y</item>
  <item>L1 / LB</item>
  <item>R1 / RB</item>
  <item>L3 (left stick click)</item>
  <item>R3 (right stick click)</item>
  <item>Create / View</item>
  <item>Options / Menu</item>
  <item>D-pad up</item>
  <item>D-pad down</item>
  <item>D-pad left</item>
  <item>D-pad right</item>
 </string-array>

 <!-- Parallel to GamepadButtons.ACTION_IDS. -->
 <string-array name="pad_action_labels" tools:ignore="MissingTranslation">
  <item>@string/label_unassigned</item>
  <item>Steer left</item>
  <item>Steer right</item>
  <item>Accelerate</item>
  <item>Brake</item>
  <item>Handbrake</item>
  <item>Shift up</item>
  <item>Shift down</item>
  <item>Camera view</item>
  <item>Horn</item>
  <item>Look behind</item>
  <item>Return to track</item>
  <item>Spike strip</item>
  <item>Headlights</item>
  <item>Menu up</item>
  <item>Menu down</item>
  <item>Menu left</item>
  <item>Menu right</item>
  <item>Confirm / OK</item>
  <item>Escape / pause</item>
 </string-array>
</resources>
