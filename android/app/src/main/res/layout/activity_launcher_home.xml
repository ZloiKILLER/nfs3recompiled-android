<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="24dp">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:background="@drawable/ui_hero" android:layout_marginRight="24dp">
   <dev.nfs3hp.port.GameTitleView android:layout_width="match_parent" android:layout_height="100dp" android:contentDescription="NEED FOR SPEED III HOT PURSUIT"/>
   <Button android:id="@+id/play_button" style="@style/LauncherPrimary" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="20dp" android:text="@string/play"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/launcher_setup" android:textColor="@color/ui_muted" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>
   <Button android:id="@+id/controls_button" android:layout_width="match_parent" android:layout_height="48dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:gravity="center_vertical|start" android:text="@string/controls_hub"/>
   <Button android:id="@+id/screen_settings_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:gravity="center_vertical|start" android:text="@string/screen_settings"/>
   <Button android:id="@+id/data_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:gravity="center_vertical|start" android:text="@string/data_settings"/>
   <Button android:id="@+id/language_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:gravity="center_vertical|start" android:text="@string/language_label"/>
   <Button android:id="@+id/faq_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:gravity="center_vertical|start" android:text="@string/faq_title"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
