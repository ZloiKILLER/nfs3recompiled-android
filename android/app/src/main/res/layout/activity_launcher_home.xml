<!-- The first screen.  The title card and the settings column are one block:
     both take the taller one's height, so the first button starts level with
     the top of the card and the last one ends level with its bottom, and the
     buttons share the column between them.  The build's version sits under
     the column. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:padding="24dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp" android:background="@drawable/ui_hero" android:layout_marginRight="24dp">
    <dev.nfs3hp.port.GameTitleView android:layout_width="match_parent" android:layout_height="124dp" android:contentDescription="NEED FOR SPEED III HOT PURSUIT"/>
    <Button android:id="@+id/play_button" style="@style/LauncherPrimary" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="24dp" android:text="@string/play"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
    <Button android:id="@+id/controls_button" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:text="@string/controls_hub"/>
    <Button android:id="@+id/screen_settings_button" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:text="@string/display_settings"/>
    <Button android:id="@+id/data_button" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:text="@string/data_settings"/>
    <Button android:id="@+id/language_button" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:text="@string/language_label"/>
    <Button android:id="@+id/faq_button" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:text="@string/faq_title"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/version_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:letterSpacing="0.08" android:textColor="@color/ui_muted" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>
