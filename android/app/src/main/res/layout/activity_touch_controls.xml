<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="20dp" android:background="@color/ui_background">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:layout_marginRight="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_settings" android:textColor="@color/ui_text" android:textSize="24sp" android:fontFamily="sans-serif-medium"/>
  <FrameLayout android:id="@+id/touch_preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:background="@drawable/ui_hero" android:clipToOutline="true"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/touch_digital_note" android:textColor="@color/ui_muted" android:textSize="12sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:orientation="horizontal">
   <Button android:id="@+id/back_button" android:layout_width="100dp" android:layout_height="match_parent" android:text="@string/back_to_launcher"/>
   <Button android:id="@id/edit_touch_layout" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="10dp" android:text="Edit positions &amp; touch zones"/>
  </LinearLayout>
 </LinearLayout>
 <ScrollView android:layout_width="230dp" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/touch_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_layout_label" android:textColor="@color/ui_text"/>
   <Spinner android:id="@+id/touch_layout_spinner" android:layout_width="match_parent" android:layout_height="48dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/opacity_label" android:textColor="@color/ui_text"/>
   <TextView android:id="@+id/opacity_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent"/>
   <SeekBar android:id="@+id/opacity_seek" android:layout_width="match_parent" android:layout_height="48dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/size_label" android:textColor="@color/ui_text"/>
   <TextView android:id="@+id/size_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent"/>
   <SeekBar android:id="@+id/size_seek" android:layout_width="match_parent" android:layout_height="48dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_edge_label" android:textColor="@color/ui_text"/>
   <TextView android:id="@+id/edge_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent"/>
   <SeekBar android:id="@+id/edge_seek" android:layout_width="match_parent" android:layout_height="48dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_raise_label" android:textColor="@color/ui_text"/>
   <TextView android:id="@+id/raise_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_accent"/>
   <SeekBar android:id="@+id/raise_seek" android:layout_width="match_parent" android:layout_height="48dp"/>
   <CheckBox android:id="@+id/auto_hide_check" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_dim_label" android:textColor="@color/ui_text"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/touch_dim_note" android:textColor="@color/ui_muted" android:textSize="12sp"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
