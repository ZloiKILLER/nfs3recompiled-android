<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@color/ui_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
  <Button android:id="@+id/editor_done" android:layout_width="wrap_content" android:minWidth="96dp" android:layout_height="match_parent" android:text="@string/editor_done" android:maxLines="1" android:ellipsize="end"/>
  <Spinner android:id="@+id/editor_mode" android:layout_width="wrap_content" android:minWidth="150dp" android:layout_height="match_parent"/>
  <TextView android:id="@+id/editor_selection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:paddingLeft="12dp" android:text="@string/editor_select_control" android:textColor="@color/ui_accent"/>
  <Button android:id="@+id/editor_reset" android:layout_width="wrap_content" android:minWidth="120dp" android:layout_height="match_parent" android:text="@string/editor_reset" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/editor_canvas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/editor_visual_label" android:layout_width="wrap_content" android:minWidth="110dp" android:maxLines="1" android:layout_height="wrap_content" android:text="" android:textColor="@color/ui_text"/>
  <SeekBar android:id="@+id/editor_visual" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
  <TextView android:id="@+id/editor_hit_label" android:layout_width="wrap_content" android:minWidth="120dp" android:maxLines="1" android:layout_height="wrap_content" android:text="" android:textColor="@color/ui_text"/>
  <SeekBar android:id="@+id/editor_hit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
 </LinearLayout>
</LinearLayout>
