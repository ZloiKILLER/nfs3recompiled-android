<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/ui_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/faq_title" android:textSize="26sp" android:textColor="@color/ui_text" android:fontFamily="sans-serif-black"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
  <TextView android:id="@+id/faq_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:background="@drawable/ui_hero" android:textSize="16sp" android:lineSpacingExtra="5dp" android:textColor="@color/ui_text"/>
 </ScrollView>
 <Button android:id="@+id/back_button" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/back_to_launcher"/>
</LinearLayout>
