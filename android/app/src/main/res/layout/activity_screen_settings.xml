<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/orientation_label"
            android:textColor="#FFFFFF" />
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/orientation_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_auto"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/orientation_landscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_landscape"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/orientation_landscape_reverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_landscape_reverse"
                android:textColor="#FFFFFF" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fps_cap_label"
            android:textColor="#FFFFFF" />
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/fps_cap_30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_30"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/fps_cap_60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fps_60"
                android:textColor="#FFFFFF" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gamma_label"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gamma_hint"
            android:textColor="#AAB5C6"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/gamma_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFBF69" />
        <SeekBar
            android:id="@+id/gamma_seek"
            android:layout_width="match_parent"
            android:layout_height="48dp" />
        <Button
            android:id="@+id/save_screen_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/back_to_launcher" />
    </LinearLayout>
</ScrollView>
