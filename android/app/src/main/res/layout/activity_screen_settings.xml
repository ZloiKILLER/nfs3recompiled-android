<?xml version="1.0" encoding="utf-8"?>
<!-- Display: orientation beside frame rate, both written the moment they are
     chosen, with the way into Screen adjustment under frame rate.  Two columns
     because this is a landscape screen: one column of choices ran the Back
     button off its bottom edge. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/display_settings"
            android:textColor="@color/ui_text"
            android:textSize="26sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_label"
                    android:textColor="@color/ui_text" />
                <RadioGroup
                    android:id="@+id/orientation_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:id="@+id/orientation_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/orientation_auto"
                        android:textColor="@color/ui_text" />
                    <RadioButton
                        android:id="@+id/orientation_landscape"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/orientation_landscape"
                        android:textColor="@color/ui_text" />
                    <RadioButton
                        android:id="@+id/orientation_landscape_reverse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/orientation_landscape_reverse"
                        android:textColor="@color/ui_text" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fps_cap_label"
                    android:textColor="@color/ui_text" />
                <RadioGroup
                    android:id="@+id/fps_cap_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:id="@+id/fps_cap_30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fps_30"
                        android:textColor="@color/ui_text" />
                    <RadioButton
                        android:id="@+id/fps_cap_60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fps_60"
                        android:textColor="@color/ui_text" />
                </RadioGroup>
                <!-- Gamma moved to its own screen when brightness and contrast
                     joined it: the three are judged against a picture, not
                     against each other, so they need the samples that screen
                     carries. -->
                <Button
                    android:id="@+id/screen_adjustment_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:minWidth="220dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/screen_adjustment" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:minWidth="120dp"
            android:text="@string/back_to_launcher" />
    </LinearLayout>
</ScrollView>
