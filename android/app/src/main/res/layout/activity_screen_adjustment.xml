<?xml version="1.0" encoding="utf-8"?>
<!-- Controls on the left, a sample on the right, so the effect of a slider is
     visible while it is being dragged.  Gamma, brightness and contrast pull
     the ends of the range in opposite directions: what rescues a night track
     can wash out a daylit one.  So the sample is a day and a night picture,
     one at a time and big enough to judge; a swipe, or a dot, turns to the
     other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="horizontal"
    android:padding="24dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_adjustment"
                android:textColor="@color/ui_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/adjust_hint"
                android:textColor="@color/ui_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gamma_label"
                    android:textColor="@color/ui_text" />
                <TextView
                    android:id="@+id/gamma_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_accent" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/gamma_seek"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brightness_label"
                    android:textColor="@color/ui_text" />
                <TextView
                    android:id="@+id/brightness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_accent" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/brightness_seek"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/contrast_label"
                    android:textColor="@color/ui_text" />
                <TextView
                    android:id="@+id/contrast_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_accent" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/contrast_seek"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- One row: stacked, the second button ran off the bottom edge. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="120dp"
                    android:text="@string/back_to_launcher" />
                <Button
                    android:id="@+id/reset_adjust_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:minWidth="120dp"
                    android:text="@string/adjust_reset" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sample_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ui_text"
            android:textSize="15sp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/sample_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <View
                android:id="@+id/sample_dot_day"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:contentDescription="@string/sample_bright" />
            <View
                android:id="@+id/sample_dot_night"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:contentDescription="@string/sample_dark" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
